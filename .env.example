# =============================================================================
# BOARDROOM MOLTBOT - Environment Configuration Example
# =============================================================================
#
# WARNING: DO NOT PUT API KEYS IN THIS FILE
#
# API keys are managed through the proxy admin UI, not environment variables.
# This file contains only non-sensitive configuration settings.
#
# To use:
# 1. Copy this file to .env
# 2. Update BOARDROOM_USER with your username
# 3. API keys are configured via the proxy admin interface
#
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration (Non-Sensitive)
# -----------------------------------------------------------------------------

# Environment: development, staging, production
NODE_ENV=production

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# Your Boardroom username (for attribution and logging)
BOARDROOM_USER=your-username

# -----------------------------------------------------------------------------
# Proxy Container Environment Variables
# -----------------------------------------------------------------------------
# These settings are for the proxy container ONLY, not the main application.
# The proxy container manages API key rotation and rate limiting.
#
# IMPORTANT: These keys should only be set in the proxy container's
# environment, not in application code or client-side configurations.
# -----------------------------------------------------------------------------

# Anthropic API Key (proxy container only)
# ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key (proxy container only)
# OPENAI_API_KEY=sk-xxx
