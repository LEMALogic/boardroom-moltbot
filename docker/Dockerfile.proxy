# Dockerfile for Boardroom API Proxy
# A Hono-based MITM proxy that intercepts ALL HTTP/HTTPS traffic
# and injects API keys for known providers (Anthropic, OpenAI, etc.)

FROM node:22-slim

# Install OpenSSL for certificate generation (needed by http-mitm-proxy)
RUN apt-get update && apt-get install -y \
    openssl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd --gid 1001 nodejs \
    && useradd --uid 1001 --gid nodejs --shell /bin/bash --create-home appuser

# Set working directory
WORKDIR /app

# Copy package files first for better layer caching
COPY api-proxy/package*.json ./
COPY api-proxy/tsconfig.json ./

# Install all dependencies (need typescript for build)
RUN npm ci \
    && npm cache clean --force

# Copy application source code
COPY api-proxy/src ./src

# Create certs directory for MITM CA certificates
RUN mkdir -p /app/certs/.http-mitm-proxy

# Build TypeScript to JavaScript
RUN npm run build

# Remove devDependencies after build
RUN npm prune --production

# Change ownership to non-root user
RUN chown -R appuser:nodejs /app

# Switch to non-root user
USER appuser

# Expose ports:
# - 8080: Admin UI and direct API endpoints
# - 3128: MITM proxy for transparent traffic interception
EXPOSE 8080 3128

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8080/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1

# Run the compiled application
CMD ["npm", "start"]
